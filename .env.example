# AWS credentials — uses the named profile from ~/.aws/credentials
AWS_PROFILE=bootcamp
AWS_DEFAULT_REGION=us-east-1

# Optional model overrides — Bedrock cross-region inference profile IDs
# Verify these against your AWS account's enabled model list
COORDINATOR_MODEL=us.anthropic.claude-opus-4-7
TRIAGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
ROUTING_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
ESCALATION_MODEL=us.anthropic.claude-sonnet-4-6

# Ticket system (mock by default)
TICKET_BACKEND=mock   # mock | jira | servicenow
TICKET_API_URL=
TICKET_API_TOKEN=

# Notification backend (mock by default)
NOTIFY_BACKEND=mock   # mock | slack | email
SLACK_WEBHOOK_URL=
